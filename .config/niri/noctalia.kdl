layout {

    focus-ring {
        active-color   "#b2e467"
        inactive-color "#1f231a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#b2e467"
        inactive-color "#1f231a"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1f231a70"
    }

    tab-indicator {
        active-color   "#b2e467"
        inactive-color "#598d0c"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#b2e46780"
    }
}

recent-windows {
    highlight {
        active-color "#b2e467"
        urgent-color "#fd4663"
    }
}
